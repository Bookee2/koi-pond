{
  "name": "koi-engine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "bake": "npm run bake:koi && npm run bake:bed && npm run bake:plants",
    "bake:bed": "/Applications/Blender.app/Contents/MacOS/Blender -b -P tools/blender/bake_pond_bed.py -- --out public/assets/bed --width 1024 --preset all",
    "bake:plants": "/Applications/Blender.app/Contents/MacOS/Blender -b -P tools/blender/bake_plants.py -- --out public/assets/plants --size 256",
    "bake:koi": "/Applications/Blender.app/Contents/MacOS/Blender -b -P tools/blender/bake_koi_atlas.py -- --out public/assets/koi --size 512"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.60",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
